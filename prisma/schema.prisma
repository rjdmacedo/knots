// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

enum CreationMethod {
  PAYMENT
  DEBT_CONSOLIDATION
  NON_MEMBER_SPLIT
}

model Group {
  id               String  @id
  name             String
  information      String? @db.Text
  currency         String  @default("$")
  currencyCode     String?
  /// When true, balances are simplified to the minimum number of payments (Splitwise-style).
  /// When false, each person owes whoever actually paid for their share.
  simplifyDebts      Boolean                  @default(true)
  expenses         Expense[]
  activities       Activity[]
  categoryMappings ExpenseCategoryMapping[]
  memberships      GroupMembership[]
  invitations      Invitation[]
  createdAt        DateTime                 @default(now())
}

model Category {
  id               Int                      @id @default(autoincrement())
  grouping         String
  name             String
  Expense          Expense[]
  categoryMappings ExpenseCategoryMapping[]
}

model Expense {
  id               String            @id
  group            Group?            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expenseDate      DateTime          @default(dbgenerated("CURRENT_DATE")) @db.Date
  title            String
  category         Category?         @relation(fields: [categoryId], references: [id])
  categoryId       Int               @default(0)
  amount           Int
  originalAmount   Int?
  originalCurrency String?
  conversionRate   Decimal?
  paidBy           User              @relation("ExpensesPaidBy", fields: [paidById], references: [id])
  paidById         String
  payers           ExpensePaidBy[]   @relation("ExpensesPaidByMulti")
  paidFor          ExpensePaidFor[]
  groupId          String?
  isReimbursement  Boolean           @default(false)
  splitMode        SplitMode         @default(EVENLY)
  createdAt        DateTime          @default(now())
  documents        ExpenseDocument[]
  notes            String?
  creationMethod   CreationMethod?
  bundleId         String?

  linkedExpenseId              String?
  expenseCurrencyCode          String?
  originalTotalAtDecomposition Int?

  // Itemized expenses (v1.1). "Itemized" is read from itemsAuthoritative, never
  // from items.length. Items may exist as documentation while a legacy split is
  // active (itemsAuthoritative = false). The "Other" remainder (tax/tip/service)
  // is a single signed pool in Entry_Currency minor units and is the source of
  // truth; remainderSplitMode + remainderShares apply only when allocation is
  // CUSTOM (PROPORTIONAL derives weights from item subtotals at compute time).
  items                   ExpenseItem[]
  itemsAuthoritative      Boolean                  @default(false)
  remainderAmount         Int? // Entry_Currency minor units, signed; null when no items
  remainderAllocationMode RemainderAllocationMode? // null when no items
  remainderSplitMode      SplitMode? // CUSTOM only: flat split mode of the "Other" line; null otherwise
  remainderShares         ExpenseRemainderShare[] // CUSTOM only

  recurrenceRule         RecurrenceRule?       @default(NONE)
  recurringExpenseLink   RecurringExpenseLink?
  recurringExpenseLinkId String?

  @@index([linkedExpenseId])
}

model ExpenseDocument {
  id        String   @id
  url       String
  width     Int
  height    Int
  Expense   Expense? @relation(fields: [expenseId], references: [id])
  expenseId String?
}

/// A single line item of an itemized expense. `amount` is in Entry_Currency
/// minor units (the currency the expense was entered in) and equals
/// `unitPrice × quantity`. `position` preserves display order and the
/// deterministic remainder order used by the splitter.
model ExpenseItem {
  id          String                  @id
  expense     Expense                 @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId   String
  title       String
  /// Line total in Entry_Currency minor units (= unitPrice × quantity).
  amount      Int
  /// Per-unit price in Entry_Currency minor units (Requirement 14).
  unitPrice   Int                     @default(0)
  /// Positive integer count; defaults to 1 (Requirement 14).
  quantity    Int                     @default(1)
  position    Int
  assignments ExpenseItemAssignment[]

  @@index([expenseId])
}

/// Links a line item to a participant it is assigned to (one item → one or more
/// participants). Cascade-deleted with either the item or the user.
model ExpenseItemAssignment {
  item   ExpenseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String
  user   User        @relation("UserExpenseItemAssignments", fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@id([itemId, userId])
  @@index([userId])
}

/// How the "Other" remainder of an itemized expense is allocated.
enum RemainderAllocationMode {
  PROPORTIONAL // in proportion to each participant's item subtotal (no rows stored)
  CUSTOM // a flat split (Expense.remainderSplitMode over ExpenseRemainderShare rows)
}

/// Per-participant rows for the "Other" remainder when allocation is CUSTOM.
/// Empty for PROPORTIONAL (weights are the item subtotals, computed on the fly).
/// Same shape as ExpensePaidFor: a participant + polymorphic `shares` whose
/// meaning follows Expense.remainderSplitMode. The split mode lives on the
/// Expense, not on each row.
model ExpenseRemainderShare {
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId String
  user      User    @relation("UserExpenseRemainderShares", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  shares    Int

  @@id([expenseId, userId])
  @@index([userId])
}

enum SplitMode {
  EVENLY
  BY_SHARES
  BY_PERCENTAGE
  BY_AMOUNT
}

model RecurringExpenseLink {
  id                    String  @id
  groupId               String?
  currentFrameExpense   Expense @relation(fields: [currentFrameExpenseId], references: [id], onDelete: Cascade)
  currentFrameExpenseId String  @unique

  // Note: We do not want to link to the next expense because once it is created, it should be 
  // treated as it's own independent entity. This means that if a user wants to delete an Expense
  // and any prior related recurring expenses, they'll need to delete them one by one.
  nextExpenseCreatedAt DateTime?
  nextExpenseDate      DateTime

  @@index([groupId])
  @@index([groupId, nextExpenseCreatedAt, nextExpenseDate(sort: Desc)])
  @@index([nextExpenseCreatedAt, nextExpenseDate])
}

enum RecurrenceRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model ExpensePaidFor {
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user      User    @relation("ExpensesPaidFor", fields: [userId], references: [id], onDelete: Cascade)
  expenseId String
  userId    String
  shares    Int     @default(1)

  @@id([expenseId, userId])
}

model ExpensePaidBy {
  expense   Expense @relation("ExpensesPaidByMulti", fields: [expenseId], references: [id], onDelete: Cascade)
  user      User    @relation("UserExpensesPaidBy", fields: [userId], references: [id], onDelete: Cascade)
  expenseId String
  userId    String
  amount    Int // minor currency units

  @@id([expenseId, userId])
}

model Activity {
  id            String           @id
  group         Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId       String
  time          DateTime         @default(now())
  activityType  ActivityType
  participantId String?
  expenseId     String?
  data          String?
  changes       ActivityChange[]

  @@index([groupId, time])
}

model ActivityChange {
  id         String   @id @default(cuid())
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId String
  field      String
  oldValue   String?
  newValue   String?

  @@index([activityId])
}

enum ActivityType {
  UPDATE_GROUP
  CREATE_EXPENSE
  CREATE_RECURRING_EXPENSE
  UPDATE_EXPENSE
  DELETE_EXPENSE
}

enum NotificationDeliveryChannel {
  EMAIL
  PUSH
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

/// Durable notification outbox. The domain mutation and these rows are committed
/// together; pg-boss is only the wake-up/retry mechanism.
model NotificationDelivery {
  id              String                      @id @default(cuid())
  eventKey        String
  recipientKey    String
  recipientUserId String?
  recipientUser   User?                       @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  category        String
  channel         NotificationDeliveryChannel
  targetKey       String
  snapshotVersion Int                         @default(1)
  snapshot        Json
  status          NotificationDeliveryStatus  @default(PENDING)
  availableAt     DateTime                    @default(now())
  leaseToken      String?
  leaseExpiresAt  DateTime?
  attempts        Int                         @default(0)
  lastError       String?                     @db.Text
  sentAt          DateTime?
  terminalAt      DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@unique([eventKey, recipientKey, channel, targetKey])
  @@index([status, availableAt])
  @@index([recipientUserId, createdAt])
  @@index([leaseExpiresAt])
}

/// One Web Push subscription per browser. Delivery is decided from the
/// account and the group membership, not from a per-group subscription row.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ExpenseCategoryMapping {
  id              String   @id @default(cuid())
  groupId         String
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  normalizedTitle String
  categoryId      Int
  category        Category @relation(fields: [categoryId], references: [id])
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([groupId, normalizedTitle])
  @@index([groupId, normalizedTitle])
}

// ─── Authentication Models ───────────────────────────────────────────────────

model User {
  id                    String    @id @default(cuid())
  name                  String
  username              String    @unique
  email                 String    @unique
  emailVerified         DateTime?
  passwordHash          String? // null only after Remove password
  image                 String?
  locale                String?
  theme                 String? // "light" | "dark" | "system"
  notificationsEnabled  Boolean   @default(true)
  timezone              String?
  preferredCurrency     String?   @default("USD")
  sessionsInvalidatedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sessions                Session[]
  accounts                Account[]
  tokens                  Token[]
  passkeys                Passkey[]
  passkeyChallenges       PasskeyChallenge[]
  emailChangeChallenges   EmailChangeChallenge[]
  notificationPreferences UserNotificationPreference[]
  memberships             GroupMembership[]
  invitationsSent         Invitation[]                 @relation("InvitedBy")
  expensesPaidBy          Expense[]                    @relation("ExpensesPaidBy")
  paidByExpenses          ExpensePaidBy[]              @relation("UserExpensesPaidBy")
  expenseItemAssignments  ExpenseItemAssignment[]      @relation("UserExpenseItemAssignments")
  expenseRemainderShares  ExpenseRemainderShare[]      @relation("UserExpenseRemainderShares")
  expensesPaidFor         ExpensePaidFor[]             @relation("ExpensesPaidFor")
  friendsOwned            Friend[]                     @relation("FriendsOwned")
  friendsLinked           Friend[]                     @relation("FriendsLinked")
  blockedUsers            BlockedUser[]                @relation("BlockedByUser")
  blockedBy               BlockedUser[]                @relation("BlockedTargetUser")
  pushSubscriptions       PushSubscription[]
  notificationDeliveries  NotificationDelivery[]
}

model Passkey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    Bytes
  counter      Int
  deviceType   String // "singleDevice" | "multiDevice"
  backedUp     Boolean  @default(false)
  name         String
  createdAt    DateTime @default(now())

  @@index([userId])
}

/// Short-lived, single-use WebAuthn challenges plus the "recent password"
/// marker used by the 5-minute add-passkey gate.
///
/// - "registration" / "authentication": store the base64url challenge the
///   server issued; `verify*` consumes (deletes) the row so a challenge can
///   only be used once. Discoverable authentication has a null `userId`.
/// - "recent-auth": no meaningful challenge; the row's existence (and unexpired
///   `expiresAt`) is the "the user confirmed their password recently" flag.
model PasskeyChallenge {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  challenge String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([challenge])
  @@index([expiresAt])
}

model EmailChangeChallenge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model UserNotificationPreference {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category String
  email    Boolean @default(false)
  push     Boolean @default(false)

  @@unique([userId, category])
}

model BlockedUser {
  id            String   @id @default(cuid())
  userId        String
  blockedEmail  String
  blockedUserId String?
  createdAt     DateTime @default(now())

  user        User  @relation("BlockedByUser", fields: [userId], references: [id], onDelete: Cascade)
  blockedUser User? @relation("BlockedTargetUser", fields: [blockedUserId], references: [id], onDelete: SetNull)

  @@unique([userId, blockedEmail])
  @@index([userId])
  @@index([blockedEmail])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Token {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      TokenType
  hash      String    @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId, type])
  @@index([hash])
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  MAGIC_LINK
}

model GroupMembership {
  id                    String         @id @default(cuid())
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId               String
  group                 Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role                  MembershipRole @default(MEMBER)
  joinedAt              DateTime       @default(now())
  archivedAt            DateTime?
  notificationOverrides GroupNotificationOverride[]

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@index([userId, archivedAt])
}

model GroupNotificationOverride {
  id           String          @id @default(cuid())
  membershipId String
  membership   GroupMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  category     String
  email        Boolean
  push         Boolean

  @@unique([membershipId, category])
  @@index([membershipId])
}

enum MembershipRole {
  OWNER
  MEMBER
}

model Invitation {
  id          String           @id @default(cuid())
  groupId     String
  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  email       String
  invitedById String
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id])
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@unique([groupId, email, status])
  @@index([groupId])
  @@index([email])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Friend {
  id           String   @id @default(cuid())
  userId       String
  email        String
  friendUserId String?
  name         String?
  createdAt    DateTime @default(now())

  owner  User  @relation("FriendsOwned", fields: [userId], references: [id], onDelete: Cascade)
  friend User? @relation("FriendsLinked", fields: [friendUserId], references: [id], onDelete: SetNull)

  @@unique([userId, email])
  @@index([userId])
}

model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
